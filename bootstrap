#!/usr/bin/env bash
# First-run setup for a fresh clone.
set -euo pipefail

if ! command -v mise >/dev/null 2>&1; then
  cat >&2 <<'MSG'
`mise` is required to install aozora's locked native toolchain.
Install it, then re-run ./bootstrap:

  https://mise.jdx.dev/getting-started.html
MSG
  exit 1
fi

export MISE_IGNORED_CONFIG_PATHS="${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml"
mise trust
mise install --locked just
exec mise exec --no-deps --locked just -- just setup
