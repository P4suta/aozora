{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "aozora",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_element"
      }
    },
    "_element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "gaiji"
        },
        {
          "type": "SYMBOL",
          "name": "slug"
        },
        {
          "type": "SYMBOL",
          "name": "explicit_ruby"
        },
        {
          "type": "SYMBOL",
          "name": "implicit_ruby"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "newline"
        },
        {
          "type": "SYMBOL",
          "name": "literal_markup"
        }
      ]
    },
    "gaiji": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 4,
        "content": {
          "type": "PATTERN",
          "value": "※［＃[^］\\n]+］"
        }
      }
    },
    "slug": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "［＃[^］\\n]+］"
        }
      }
    },
    "explicit_ruby": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "｜[^《｜\\n]+《[^》\\n]+》"
        }
      }
    },
    "implicit_ruby": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[\\u4E00-\\u9FFF\\u3400-\\u4DBF\\uF900-\\uFAFF\\u3005\\u30F5\\u30F6]+《[^》\\n]+》"
        }
      }
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\\n《》｜［］＃※]+|[》］＃]"
    },
    "newline": {
      "type": "PATTERN",
      "value": "\\n"
    },
    "literal_markup": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}