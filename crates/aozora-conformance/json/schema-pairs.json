{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AozoraPairsEnvelope",
  "description": "Envelope returned by aozora::json::pairs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Wire schema version. See aozora::json::SCHEMA_VERSION.",
      "type": "integer",
      "const": 3
    },
    "data": {
      "description": "Per-entry payload array; one item per emitted diagnostic / node / pair.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "open": {
            "$ref": "#/$defs/Span"
          },
          "close": {
            "$ref": "#/$defs/Span"
          }
        },
        "required": [
          "kind",
          "open",
          "close"
        ],
        "description": "One `pairs` envelope entry — a matched bracket pair.",
        "title": "Pair"
      }
    }
  },
  "$defs": {
    "Span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "description": "One half-open `[start, end)` byte span in a wire envelope."
    }
  }
}
