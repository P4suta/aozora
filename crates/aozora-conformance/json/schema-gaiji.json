{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AozoraGaijiEnvelope",
  "description": "Envelope returned by aozora::json::gaiji.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Wire schema version. See aozora::json::SCHEMA_VERSION.",
      "type": "integer",
      "const": 3
    },
    "data": {
      "description": "Per-entry payload array; one item per emitted diagnostic / node / pair.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "span": {
            "$ref": "#/$defs/Span"
          },
          "description": {
            "type": "string"
          },
          "mencode": {
            "type": [
              "string",
              "null"
            ]
          },
          "codepoint": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "resolved": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "span",
          "description"
        ],
        "description": "A gaiji entry with `span`, `description`, `mencode`, `codepoint`, and `resolved` fields.\n\nThe span uses original-source byte offsets.\nOptional fields use `null` for absent values.",
        "title": "GaijiResolution"
      }
    }
  },
  "$defs": {
    "Span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "description": "One half-open `[start, end)` byte span in a wire envelope."
    }
  }
}
