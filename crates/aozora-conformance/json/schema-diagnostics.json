{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AozoraDiagnosticsEnvelope",
  "description": "Envelope returned by aozora::json::diagnostics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Wire schema version. See aozora::json::SCHEMA_VERSION.",
      "type": "integer",
      "const": 2
    },
    "data": {
      "description": "Per-entry payload array; one item per emitted diagnostic / node / pair.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "span": {
            "$ref": "#/$defs/Span"
          },
          "codepoint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1
          }
        },
        "required": [
          "kind",
          "severity",
          "source",
          "span"
        ],
        "description": "One `diagnostics` envelope entry — a projected [`crate::Diagnostic`].",
        "title": "Diagnostic"
      }
    }
  },
  "$defs": {
    "Span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "description": "One half-open `[start, end)` byte span in a wire envelope."
    }
  }
}
