{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AozoraContainerPairsEnvelope",
  "description": "Envelope returned by aozora::json::container_pairs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Wire schema version. See aozora::json::SCHEMA_VERSION.",
      "type": "integer",
      "const": 1
    },
    "data": {
      "description": "Per-entry payload array; one item per emitted diagnostic / node / pair.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "open": {
            "$ref": "#/$defs/Offset"
          },
          "close": {
            "$ref": "#/$defs/Offset"
          }
        },
        "required": [
          "kind",
          "open",
          "close"
        ],
        "description": "One `container_pairs` envelope entry — a paired container, open/close\nin normalized coordinates.",
        "title": "ContainerPair"
      }
    }
  },
  "$defs": {
    "Offset": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "offset"
      ],
      "description": "A single byte offset (a `container_pairs` open/close in normalized\ncoordinates)."
    }
  }
}
