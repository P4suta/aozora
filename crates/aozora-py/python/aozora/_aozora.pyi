"""Type declarations for the compiled Aozora extension."""

class Document:
    def __init__(self, source: str) -> None: ...
    @staticmethod
    def from_bytes(data: bytes) -> Document: ...
    @property
    def source(self) -> str: ...
    def source_byte_len(self) -> int: ...
    def to_html(self) -> str: ...
    def to_source(self) -> str: ...
    def diagnostics_text(self) -> str: ...
    def diagnostics_json(self) -> str: ...
    def nodes_json(self) -> str: ...
    def pairs_json(self) -> str: ...
    def container_pairs_json(self) -> str: ...
    def gaiji_json(self) -> str: ...

def parse_to_html(source: str) -> str: ...
def prewarm() -> None: ...
def decode_sjis(data: bytes) -> str: ...
def slugs_json() -> str: ...
def version() -> str: ...
def schema_version() -> int: ...
