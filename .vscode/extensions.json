{
  // Mirrors the extensions the Dev Container auto-installs
  // (.devcontainer/devcontainer.json), so a host VS Code recommends the
  // same set. `remote-containers` is added because the workflow is
  // Docker-first: "Reopen in Container" is the supported path.
  "recommendations": [
    "rust-lang.rust-analyzer",
    "tamasfe.even-better-toml",
    "serayuzgur.crates",
    "vadimcn.vscode-lldb",
    "EditorConfig.EditorConfig",
    "skellock.just",
    "ms-azuretools.vscode-docker",
    "ms-playwright.playwright",
    "ms-vscode-remote.remote-containers"
  ]
}
