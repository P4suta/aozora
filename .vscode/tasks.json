{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ci",
      "type": "shell",
      "command": "just ci",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "detail": "Full local fixed CI gate."
    },
    {
      "label": "test",
      "type": "shell",
      "command": "just test",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "test (filter)",
      "type": "shell",
      "command": "just t ${input:filter}",
      "group": "test",
      "problemMatcher": ["$rustc"],
      "detail": "Run tests matching a nextest filter (substring or /regex/)."
    },
    {
      "label": "clippy",
      "type": "shell",
      "command": "just clippy",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "check",
      "type": "shell",
      "command": "just check",
      "problemMatcher": ["$rustc"]
    }
  ],
  "inputs": [
    {
      "id": "filter",
      "type": "promptString",
      "description": "nextest filter (substring or /regex/)"
    }
  ]
}
