# Rust
/target
/crates/*/target
**/*.rs.bk

# Cargo
Cargo.lock.bak
# CARGO_HOME inside the dev container resolves to /workspace/.cargo, which bind-mounts
# onto this directory. The registry/git caches underneath are docker volumes and
# should never be tracked.
/.cargo/
# Inner Cargo.lock generated when building upstream/comrak standalone (e.g. for
# running its own test suite). The workspace-root Cargo.lock is authoritative.
/upstream/comrak/Cargo.lock

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# mdbook build output
/crates/aozora-book/book/

# wasm-pack output (regenerated by `wasm-pack build --target web crates/aozora-wasm`)
/crates/aozora-wasm/pkg/

# wasm-pack `--target nodejs` output for the cross-surface parity walker
# (`just parity-wasm` / ci.yml wasm-build). Regenerated build artifact.
/crates/aozora-wasm/pkg-nodejs/

# Extism plugin artifact (regenerated by `just extism-build`); the single
# portable `aozora.wasm` is published as a release asset, not tracked.
/crates/aozora-extism/dist/

# The host SDK packages embed a copy of that same `aozora.wasm`, dropped in
# by `just smoke-<lang>` / the release workflow. Built artifact, not tracked.
/crates/aozora-go/aozora.wasm

# Vite build output for the web playground
/playground/dist/

# Playwright E2E artifacts (#335)
/playground/test-results/
/playground/playwright-report/
/playground/blob-report/
/playground/.playwright/

# Coverage
/coverage/
*.profraw
*.profdata
lcov.info

# Node (for aozora-book, playwright)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
playwright-report/
test-results/

# Python (aozora-py PyO3 bindings) — maturin / pytest / mypy artifacts.
# The smoke-py venv + built wheels live under target/, already ignored.
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/

# Fuzz — libFuzzer corpora and artifacts are working state, not source.
# See `docs/fuzz-workflow.md` and `crates/<crate>/tests/fuzz_regressions/`
# (the permanent regression set is committed; the rolling corpus is not).
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
crates/*/fuzz/target/
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/
crates/*/fuzz/Cargo.lock

# Criterion
/target/criterion/

# dhat heap-profile output (written to the workspace root by `just dhat`)
dhat-heap.json

# Local env overrides
.env
.env.local
/docker-compose.override.yml

# Ad-hoc scratch files (render outputs, debug dumps, …)
.tmp-*

# macOS junk in WSL mounts
:2e*

# Claude Code harness state — per-session scheduled-task locks etc.
# These are local-tooling artifacts, never project-tracked content.
.claude/
# CLAUDE.md is a per-developer working file, not a shared artefact.
CLAUDE.md
CLAUDE.local.md
