{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["bun", "node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts",
    "src/samples.ts",
    "scripts/**/*.ts"
  ]
}
