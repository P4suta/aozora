{
  "name": "aozora-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint:css": "stylelint --config ./.stylelintrc.json 'src/**/*.css' '../crates/aozora-render/assets/*.css'",
