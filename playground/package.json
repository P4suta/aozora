{
  "name": "aozora-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React 19 and Spectrum 2 authoring playground for Aozora notation.",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "preview:production": "bun scripts/serve-production.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "bun run build && playwright test",
    "lighthouse": "bun scripts/run-lighthouse.ts",
    "lint": "biome check --formatter-enabled=true --linter-enabled=true --error-on-warnings .",
    "lint:fix": "biome check --formatter-enabled=true --linter-enabled=true --write .",
    "lint:css": "stylelint --config ./.stylelintrc.json 'src/**/*.css' '../crates/aozora/assets/*.css'",
    "lint:css:fix": "stylelint --fix --config ./.stylelintrc.json 'src/**/*.css' '../crates/aozora/assets/*.css'",
    "check:bundle": "bun scripts/check-bundle-budget.ts",
    "check:legacy": "bun scripts/check-legacy.ts"
  },
  "dependencies": {
    "@aozora/playground-ui": "file:../playground-ui",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.1",
    "@react-spectrum/s2": "^1.6.0",
    "lz-string": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@react-aria/optimize-locales-plugin": "^2.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.12",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "postcss": "^8.5.25",
    "tmp": "^0.2.4",
    "uuid": "^11.1.1",
    "vite": "^8.2.0"
  },
  "browserslist": "last 2 Chrome versions, last 2 Safari versions, last 2 Firefox versions, last 2 Edge versions"
}
