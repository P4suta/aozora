    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "lz-string": "^1.5.0",
    "marked": "^18.0.4",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.16",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
